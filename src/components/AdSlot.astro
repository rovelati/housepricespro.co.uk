---
// AdSlot.astro — High-performance Google AdSense Slot with zero CLS
interface Props {
  slot?: string;
  format?: 'auto' | 'fluid' | 'rectangle' | 'horizontal';
  minHeight?: number;
  class?: string;
}

const {
  slot,
  format = 'auto',
  minHeight = 100,
  class: className = '',
} = Astro.props;

const adClient = 'ca-pub-2168172914069272';
---

<aside
  class={`hpp-ad-container my-8 rounded-xl border border-dashed border-slate-300 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-900/60 p-4 text-center ${className}`}
  aria-label="Advertisement"
>
  <div class="mb-2 text-[10px] font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-500 select-none">
    <span>ADVERTISEMENT</span>
  </div>
  <div class="flex w-full items-center justify-center overflow-hidden" style={`min-height: ${minHeight}px;`}>
    <ins
      class="adsbygoogle"
      style={`display:block; min-height: ${minHeight}px; width:100%;`}
      data-ad-client={adClient}
      {...(slot ? { 'data-ad-slot': slot } : {})}
      data-ad-format={format}
      data-full-width-responsive="true"
    ></ins>
  </div>
</aside>

<script is:inline>
  (function () {
    if (typeof window === 'undefined') return;
    if (window.__hppAdsInit) return;
    window.__hppAdsInit = true;

    function pushAd(ins) {
      if (!ins || ins.getAttribute('data-hpp-loaded') === '1') return;
      ins.setAttribute('data-hpp-loaded', '1');
      try {
        (window.adsbygoogle = window.adsbygoogle || []).push({});
      } catch (e) {}
    }

    function initAds() {
      var elements = document.querySelectorAll('ins.adsbygoogle');
      elements.forEach(pushAd);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAds);
    } else {
      initAds();
    }
  })();
</script>
