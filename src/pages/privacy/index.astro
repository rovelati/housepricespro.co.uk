---
// src/pages/privacy/index.astro — Privacy Policy (UK GDPR Compliant)
import Layout from '../../layouts/Layout.astro';

const title = 'Privacy Policy | HousePricesPro UK';
const description = 'HousePricesPro privacy policy. Information on how we process data in compliance with the UK General Data Protection Regulation (UK GDPR) and Data Protection Act 2018.';
---

<Layout title={title} description={description}>
  <div class="max-w-4xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white mb-6">Privacy Policy</h1>
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 sm:p-10 text-xs sm:text-sm text-slate-600 dark:text-slate-300 space-y-4 leading-relaxed">
      <p>Last updated: October 2026</p>
      <h2 class="text-base font-bold text-slate-900 dark:text-white mt-4">1. Introduction</h2>
      <p>HousePricesPro.co.uk ("we", "us", "our") respects your privacy and is committed to protecting your personal data in accordance with the UK General Data Protection Regulation (UK GDPR) and Data Protection Act 2018.</p>

      <h2 class="text-base font-bold text-slate-900 dark:text-white mt-4">2. Public Register Information</h2>
      <p>Property sold prices and transaction histories displayed on this website are public records published by HM Land Registry under the Open Government Licence v3.0. We do not publish names or personal identifiers of individual buyers or sellers.</p>

      <h2 class="text-base font-bold text-slate-900 dark:text-white mt-4">3. Lead Generation & Referral Services</h2>
      <p>When you request a valuation or compare mortgages, you may provide your contact details (postcode, phone number, email). With your explicit consent, these details are securely transmitted to FCA-regulated mortgage partners or vetted local estate agents to provide the requested quote.</p>

      <h2 class="text-base font-bold text-slate-900 dark:text-white mt-4">4. Your Rights</h2>
      <p>Under the UK GDPR, you have the right to request access to, rectification of, or erasure of your personal data. To exercise these rights, email us at <a href="mailto:privacy@housepricespro.co.uk" class="text-blue-600 underline">privacy@housepricespro.co.uk</a>.</p>
    </div>
  </div>
</Layout>
