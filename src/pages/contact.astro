---
// src/pages/contact.astro — Direct Inquiries & Data Rights Desk for HousePricesPro.co.uk
import Layout from '../layouts/Layout.astro';
import AdSlot from '../components/AdSlot.astro';

const title = 'Contact Us | HousePricesPro.co.uk — UK Property Registry Support';
const description = 'Get in touch with the HousePricesPro.co.uk editorial team, submit HM Land Registry data correction inquiries, request UK GDPR privacy assistance, or partner with us.';

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact HousePricesPro.co.uk",
  "url": "https://housepricespro.co.uk/contact/",
  "description": description,
  "mainEntity": {
    "@type": "Organization",
    "name": "HousePricesPro UK",
    "url": "https://housepricespro.co.uk",
    "contactPoint": [
      {
        "@type": "ContactPoint",
        "contactType": "editorial support",
        "email": "contact@housepricespro.co.uk",
        "areaServed": "GB",
        "availableLanguage": ["English"]
      },
      {
        "@type": "ContactPoint",
        "contactType": "data protection officer",
        "email": "privacy@housepricespro.co.uk",
        "areaServed": "GB",
        "availableLanguage": ["English"]
      }
    ]
  }
};
---

<Layout title={title} description={description} schema={contactSchema}>
  <!-- Hero Section -->
  <div class="bg-gradient-to-b from-slate-900 to-slate-950 text-white pt-12 pb-16 border-b border-slate-800">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/30 text-blue-400 text-xs font-semibold mb-4">
        <span class="w-2 h-2 rounded-full bg-blue-400"></span>
        UK Property Registry Support
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight mb-4">
        Contact Our Property Research Desk
      </h1>
      <p class="text-slate-300 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
        Whether you have questions regarding HM Land Registry transaction data, need clarification on an automated property estimate, or want to discuss commercial data integration, our London team is here to assist.
      </p>
    </div>
  </div>

  <!-- Content Container -->
  <div class="max-w-4xl mx-auto px-4 -mt-8 relative z-20 pb-20 space-y-10">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Contact Info & Department Routing -->
      <div class="md:col-span-1 space-y-4">
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 shadow-xl space-y-5 text-xs text-slate-600 dark:text-slate-300">
          <h2 class="text-sm font-bold text-slate-900 dark:text-white uppercase tracking-wider">Department Inquiries</h2>

          <div>
            <span class="font-semibold text-slate-900 dark:text-white block mb-0.5">Editorial & Research</span>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 mb-1">Methodology questions, market reports, and property trend analysis.</p>
            <a href="mailto:research@housepricespro.co.uk" class="text-blue-600 dark:text-blue-400 underline font-medium">research@housepricespro.co.uk</a>
          </div>

          <div class="pt-4 border-t border-slate-100 dark:border-slate-800">
            <span class="font-semibold text-slate-900 dark:text-white block mb-0.5">Land Registry Corrections</span>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 mb-1">Discrepancy notices regarding Price Paid Data filings or tenure classifications.</p>
            <a href="mailto:corrections@housepricespro.co.uk" class="text-blue-600 dark:text-blue-400 underline font-medium">corrections@housepricespro.co.uk</a>
          </div>

          <div class="pt-4 border-t border-slate-100 dark:border-slate-800">
            <span class="font-semibold text-slate-900 dark:text-white block mb-0.5">UK GDPR & Privacy Desk</span>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 mb-1">Inquiries regarding statutory public register disclosure or cookie preferences.</p>
            <a href="mailto:privacy@housepricespro.co.uk" class="text-blue-600 dark:text-blue-400 underline font-medium">privacy@housepricespro.co.uk</a>
          </div>

          <div class="pt-4 border-t border-slate-100 dark:border-slate-800">
            <span class="font-semibold text-slate-900 dark:text-white block mb-0.5">Commercial & Syndication</span>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 mb-1">API integration for mortgage underwriters, surveyors, and proptech platforms.</p>
            <a href="mailto:partners@housepricespro.co.uk" class="text-blue-600 dark:text-blue-400 underline font-medium">partners@housepricespro.co.uk</a>
          </div>
        </div>

        <div class="bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 text-xs text-slate-500 dark:text-slate-400 space-y-2">
          <div class="flex items-center gap-2 text-slate-700 dark:text-slate-300 font-semibold">
            <svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Response Commitments</span>
          </div>
          <p class="text-[11px] leading-relaxed">
            All submitted inquiries are reviewed by our property analysts within 24 to 48 business hours (Monday to Friday, 09:00 - 17:30 GMT).
          </p>
        </div>
      </div>

      <!-- Contact Submission Form Card -->
      <div class="md:col-span-2">
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 sm:p-8 shadow-xl text-xs sm:text-sm text-slate-600 dark:text-slate-300">
          <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Send an Inquiry</h2>
          <p class="text-xs text-slate-500 dark:text-slate-400 mb-6">
            Fill out the form below and your message will be automatically routed to the appropriate property research specialist.
          </p>

          <form class="space-y-4" onsubmit="event.preventDefault(); document.getElementById('form-feedback').classList.remove('hidden');">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Full Name *</label>
                <input
                  type="text"
                  required
                  placeholder="e.g. Richard Thornton"
                  class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:outline-none text-xs"
                />
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Email Address *</label>
                <input
                  type="email"
                  required
                  placeholder="name@example.co.uk"
                  class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:outline-none text-xs"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Inquiry Category *</label>
                <select class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:outline-none text-xs">
                  <option>Land Registry Sold Price Question</option>
                  <option>Valuation Estimate Clarification</option>
                  <option>Data Rectification / UK GDPR Request</option>
                  <option>Mortgage / Stamp Duty Calculator Feedback</option>
                  <option>Press, Editorial & Media Request</option>
                  <option>Commercial API Partnership</option>
                </select>
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">UK Postcode / Property Address (Optional)</label>
                <input
                  type="text"
                  placeholder="e.g. SW1A 1AA or Manchester M1"
                  class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:outline-none text-xs"
                />
              </div>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Message Details *</label>
              <textarea
                rows="5"
                required
                placeholder="Please describe your query in detail. For Land Registry transaction verification, include the registered sale year and property type..."
                class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:outline-none text-xs"
              ></textarea>
            </div>

            <div class="text-[11px] text-slate-500 dark:text-slate-400 leading-normal">
              By submitting this form, you acknowledge that your details will be processed in accordance with our <a href="/privacy/" class="text-blue-600 underline">Privacy Policy</a>. We never sell your personal information to third-party mortgage broker lead generators.
            </div>

            <button
              type="submit"
              class="w-full sm:w-auto px-6 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs rounded-lg shadow-sm hover:shadow transition"
            >
              Submit Inquiry
            </button>

            <div id="form-feedback" class="hidden p-3 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300 text-xs rounded-lg">
              ✓ Thank you for contacting HousePricesPro.co.uk. Your message has been received by our editorial team and assigned ticket reference #HPP-{Math.floor(100000 + Math.random() * 900000)}.
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- Ad Slot -->
    <AdSlot format="horizontal" />
  </div>
</Layout>
