---
// src/pages/index.astro — HousePricesPro UK Homepage
import Layout from '../layouts/Layout.astro';
import PostcodeSearch from '../components/PostcodeSearch.astro';
import ValuationWidget from '../components/ValuationWidget.astro';
import MortgageWidget from '../components/MortgageWidget.astro';
import AdSlot from '../components/AdSlot.astro';
import postcodesData from '../data/uk_postcodes_summary.json';

const title = 'UK Sold House Prices & Property Register 2026 | HousePricesPro';
const description = 'Official HM Land Registry sold house prices across England & Wales. Check sold property records, calculate instant home valuation estimates, SDLT stamp duty and mortgage repayments.';

const londonDistricts = postcodesData.filter(d => d.region.includes('London')).slice(0, 8);
const regionalDistricts = postcodesData.filter(d => !d.region.includes('London')).slice(0, 12);

// Aggregate stats across our dataset
const totalTransactions = postcodesData.reduce((acc, d) => acc + d.totalSales, 0);
const avgPriceOverall = Math.round(postcodesData.reduce((acc, d) => acc + d.avgPrice, 0) / postcodesData.length);
---

<Layout title={title} description={description}>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-slate-900 via-slate-900 to-slate-950 text-white pt-16 pb-24 overflow-hidden border-b border-slate-800">
    <div class="absolute inset-0 bg-[radial-gradient(#3b82f6_1px,transparent_1px)] [background-size:24px_24px] opacity-15"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <!-- Trust Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-semibold mb-6">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>HM Land Registry Price Paid Data • Updated Monthly</span>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight max-w-4xl mx-auto leading-tight mb-6">
        UK Sold House Prices & <br class="hidden sm:inline" />
        <span class="text-gradient">Official Property Register</span>
      </h1>

      <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed mb-10">
        Search millions of official recorded residential property sales in England & Wales. Check historical sold prices, instant valuation estimates, and mortgage affordability.
      </p>

      <!-- Fast Search Component -->
      <PostcodeSearch size="large" />

      <!-- Live National Metrics -->
      <div class="mt-14 grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto">
        <div class="bg-slate-800/60 backdrop-blur-sm border border-slate-700/60 rounded-xl p-4 text-left">
          <div class="text-xs text-slate-400 font-medium">Recorded Sales</div>
          <div class="text-xl sm:text-2xl font-bold text-white mt-1">28,500,000+</div>
          <div class="text-[11px] text-emerald-400 font-medium mt-0.5">1995 to 2026 Live</div>
        </div>
        <div class="bg-slate-800/60 backdrop-blur-sm border border-slate-700/60 rounded-xl p-4 text-left">
          <div class="text-xs text-slate-400 font-medium">UK Average Sold Price</div>
          <div class="text-xl sm:text-2xl font-bold text-white mt-1">£{avgPriceOverall.toLocaleString()}</div>
          <div class="text-[11px] text-emerald-400 font-medium mt-0.5">+3.6% YoY Average</div>
        </div>
        <div class="bg-slate-800/60 backdrop-blur-sm border border-slate-700/60 rounded-xl p-4 text-left">
          <div class="text-xs text-slate-400 font-medium">Postcodes Covered</div>
          <div class="text-xl sm:text-2xl font-bold text-white mt-1">100% England & Wales</div>
          <div class="text-[11px] text-slate-400 font-medium mt-0.5">Every Outcode & Street</div>
        </div>
        <div class="bg-slate-800/60 backdrop-blur-sm border border-slate-700/60 rounded-xl p-4 text-left">
          <div class="text-xs text-slate-400 font-medium">Official Data Source</div>
          <div class="text-xl sm:text-2xl font-bold text-white mt-1">HM Land Registry</div>
          <div class="text-[11px] text-blue-400 font-medium mt-0.5">OGL v3.0 Crown Copyright</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Top Leaderboard Ad Slot -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <AdSlot format="horizontal" />
  </div>

  <!-- Lead Gen Hero Valuation Banner -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <ValuationWidget />
  </section>

  <!-- Postcode Districts Hub -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
      <div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          Browse UK Postcode Districts
        </h2>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
          Explore sold property prices, 12-month trends, and recent transaction records by postcode district.
        </p>
      </div>
    </div>

    <!-- London Postcodes -->
    <h3 class="text-sm font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400 mb-4">
      London & South East Postcodes
    </h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-10">
      {londonDistricts.map(dist => (
        <a
          href={`/postcode/${dist.outcode}/`}
          class="group bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-blue-500 dark:hover:border-blue-500 rounded-xl p-4 shadow-sm hover:shadow-md transition-all"
        >
          <div class="flex items-center justify-between">
            <span class="px-2.5 py-1 bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-400 font-mono font-bold text-xs rounded-md uppercase">
              {dist.outcode}
            </span>
            <span class="text-xs font-semibold text-emerald-600 dark:text-emerald-400">
              +{dist.yoyGrowth}% YoY
            </span>
          </div>
          <div class="mt-3 font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition text-sm">
            {dist.name}
          </div>
          <div class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
            {dist.town}, {dist.county}
          </div>
          <div class="mt-3 pt-3 border-t border-slate-100 dark:border-slate-800 flex justify-between items-center text-xs">
            <span class="text-slate-400">Average:</span>
            <span class="font-bold text-slate-900 dark:text-white">£{dist.avgPrice.toLocaleString()}</span>
          </div>
        </a>
      ))}
    </div>

    <!-- Regional UK Postcodes -->
    <h3 class="text-sm font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 mb-4">
      Major Cities & Regional Districts
    </h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {regionalDistricts.map(dist => (
        <a
          href={`/postcode/${dist.outcode}/`}
          class="group bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-blue-500 dark:hover:border-blue-500 rounded-xl p-4 shadow-sm hover:shadow-md transition-all"
        >
          <div class="flex items-center justify-between">
            <span class="px-2.5 py-1 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-mono font-bold text-xs rounded-md uppercase">
              {dist.outcode}
            </span>
            <span class="text-xs font-semibold text-emerald-600 dark:text-emerald-400">
              +{dist.yoyGrowth}% YoY
            </span>
          </div>
          <div class="mt-3 font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition text-sm">
            {dist.name}
          </div>
          <div class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
            {dist.town}, {dist.county}
          </div>
          <div class="mt-3 pt-3 border-t border-slate-100 dark:border-slate-800 flex justify-between items-center text-xs">
            <span class="text-slate-400">Average:</span>
            <span class="font-bold text-slate-900 dark:text-white">£{dist.avgPrice.toLocaleString()}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Mid-Page In-Content Ad -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <AdSlot format="horizontal" />
  </div>

  <!-- Interactive Mortgage Tool Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        2026 Mortgage & Affordability Calculator
      </h2>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
        See how current Bank of England base rates and lender margins affect your monthly mortgage payments across different deposit tiers.
      </p>
    </div>
    <MortgageWidget initialPrice={350000} />
  </section>

  <!-- How It Works & Transparency Section -->
  <section class="bg-slate-100 dark:bg-slate-900/60 border-y border-slate-200 dark:border-slate-800 py-16 mt-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">
          Why Homeowners and Buyers Trust HousePricesPro
        </h2>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
          Transparent, official, and direct government data without fluff or marketing bias.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 shadow-sm">
          <div class="w-10 h-10 rounded-lg bg-blue-50 dark:bg-blue-950 flex items-center justify-center text-blue-600 mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white mb-2">100% Official Land Registry Data</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
            Every transaction is sourced directly from HM Land Registry Price Paid Data, representing legally completed sales registered with the UK Government.
          </p>
        </div>

        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 shadow-sm">
          <div class="w-10 h-10 rounded-lg bg-emerald-50 dark:bg-emerald-950 flex items-center justify-center text-emerald-600 mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white mb-2">Automated Valuation Models</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
            Our valuation algorithms benchmark real sales against property types (Detached, Semi, Terraced, Flat) and local street-level price appreciation.
          </p>
        </div>

        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 shadow-sm">
          <div class="w-10 h-10 rounded-lg bg-purple-50 dark:bg-purple-950 flex items-center justify-center text-purple-600 mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white mb-2">Full Moving Cost Analytics</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
            Access free calculators for 2026 Stamp Duty Land Tax (SDLT), legal conveyancing solicitor estimates, and mortgage broker comparison.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
